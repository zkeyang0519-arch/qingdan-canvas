# Copy to .dev.vars only when testing with your own verified sender.
# Automated tests use an isolated fake mail provider and need no secrets.
RESEND_API_KEY=""
EMAIL_FROM="轻单 <noreply@your-domain.example>"
# A separate randomly generated secret, at least 32 characters.
EMAIL_CODE_SECRET=""
# MCP is disabled until PUBLIC_ORIGIN and a dedicated OAUTH_KV binding are configured.
MCP_ENABLED="false"
# Exact origin, no trailing slash. Keep production and preview origins separate.
# PUBLIC_ORIGIN="https://canvas.example.com"
# Comma-separated exact browser origins; native clients without Origin are allowed.
MCP_ALLOWED_ORIGINS=""

# Step 6: independent chat model. Set real keys only in ignored .dev.vars
# locally or via Wrangler secrets for deployment; never expose them to the UI.
CHAT_ENABLED="false"
PROJECT_SUMMARY_ENABLED="false"
BATCH_QUEUE_ENABLED="false"
ROUTER_API_KEY=""
ROUTER_BASE_URL="https://api.deepseek.com"
ROUTER_MODEL="deepseek-flash"
ROUTER_API_FORMAT="chat_completions"
