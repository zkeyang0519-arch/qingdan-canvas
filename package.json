{
  "name": "qingdan-canvas",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:agent": "node --test tests/agent-contracts.test.mjs tests/agent-sort.test.mjs",
    "test:runner": "node --test tests/runner-codex.test.mjs",
    "test:experience": "node --test tests/agent-experience-ui.test.mjs tests/agent-experience-server.test.mjs tests/agent-experience-launcher.test.mjs",
    "runner:protocol": "node scripts/generate-codex-protocol.mjs",
    "runner:check": "tsc --noEmit -p runner/tsconfig.json",
    "runner:build": "npm run runner:check && node scripts/build-runner.mjs",
    "runner:smoke": "node scripts/agent-codex-smoke.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "db:local": "wrangler d1 migrations apply qingdan-canvas --local",
    "db:remote": "wrangler d1 migrations apply qingdan-canvas --remote",
    "db:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .tmp/deploy",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write src worker shared scripts tests *.json *.js docs/*.md README.md"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@fullcalendar/react": "7.1.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@ncdai/react-wheel-picker": "1.2.3",
    "@radix-ui/react-popover": "1.3.1",
    "agents": "0.30.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.0.0",
    "temporal-polyfill": "1.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "jsdom": "30.1.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "wrangler": "^4.151.2",
    "ws": "^8.22.0"
  }
}
