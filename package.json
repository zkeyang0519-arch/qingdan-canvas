{
  "name": "qingdan-canvas",
  "version": "0.3.12",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "tauri:dev": "node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "tauri:check": "node scripts/tauri.mjs check",
    "dev": "node scripts/dev-agent.mjs",
    "dev:agent": "node scripts/dev-agent.mjs",
    "dev:pi": "node scripts/pi-local/server.mjs",
    "desktop": "node scripts/desktop.mjs",
    "desktop:install": "node node_modules/electron/install.js",
    "agent:install": "node scripts/agent-install.mjs install",
    "agent:start": "node scripts/agent-install.mjs start",
    "agent:stop": "node scripts/agent-install.mjs stop",
    "agent:restart": "node scripts/agent-install.mjs restart",
    "agent:diagnose": "node scripts/agent-install.mjs diagnose",
    "agent:recover-web": "node scripts/agent-install.mjs recover-web",
    "agent:repair": "node scripts/agent-install.mjs repair",
    "agent:uninstall": "node scripts/agent-install.mjs uninstall",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:agent": "node --test tests/agent-contracts.test.mjs tests/agent-sort.test.mjs",
    "test:runner": "node --test tests/runner-codex.test.mjs tests/runner-transport.test.mjs tests/runner-workspaces.test.mjs",
    "test:experience": "node --test tests/agent-experience-server.test.mjs tests/agent-experience-launcher.test.mjs tests/agent-device-ui.test.mjs tests/local-runner-api.test.mjs",
    "test:devices": "node --test tests/agent-pairing.test.mjs tests/runner-transport.test.mjs tests/runner-workspaces.test.mjs tests/agent-device-ui.test.mjs tests/local-runner-api.test.mjs",
    "test:execution": "node --test tests/execution-mcp.test.mjs tests/execution-dispatch-recovery.test.mjs tests/runner-execution.test.mjs tests/agent-execution-ui.test.mjs tests/execution-trial.test.mjs tests/local-runner-api.test.mjs",
    "runner:protocol": "node scripts/generate-codex-protocol.mjs",
    "runner:check": "tsc --noEmit -p runner/tsconfig.json",
    "runner:build": "npm run runner:check && node scripts/build-runner.mjs",
    "runner:smoke": "node scripts/agent-codex-smoke.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "db:local": "wrangler d1 migrations apply qingdan-canvas --local",
    "db:remote": "wrangler d1 migrations apply qingdan-canvas --remote",
    "db:preview": "wrangler d1 migrations apply PREVIEW_DB --remote --config wrangler.preview-migrations.jsonc",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .tmp/deploy",
    "deploy": "node scripts/deploy.mjs",
    "format": "prettier --write src worker shared scripts tests *.json *.js docs/*.md README.md",
    "desktop:package": "node scripts/package-desktop.mjs",
    "desktop:service:package": "npm run runner:build && node scripts/package-local-service.mjs",
    "desktop:inspect": "node scripts/inspect-desktop-package.mjs",
    "desktop:download:check": "node scripts/check-desktop-download-page.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fullcalendar/react": "7.1.3",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@ncdai/react-wheel-picker": "1.2.3",
    "@radix-ui/react-popover": "1.3.1",
    "agents": "0.30.1",
    "class-variance-authority": "0.7.1",
    "cn": "^0.5.2",
    "electron-updater": "6.8.11",
    "fflate": "^0.8.3",
    "js-yaml": "4.3.2",
    "lucide-react": "^0.468.0",
    "radix-ui": "1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.0.0",
    "temporal-polyfill": "1.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@earendil-works/pi-mcp": "1.5.2",
    "@openai/codex": "0.167.0-alpha.4.1",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.12.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.25.12",
    "jsdom": "30.1.2",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "qingdan-pi-cli": "npm:@earendil-works/pi-coding-agent@1.5.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "wrangler": "^4.151.2",
    "ws": "^8.22.0"
  }
}
