{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qingdan-canvas",
  "account_id": "d6997d4bf6dea6be5f3a1ddfe225cab0",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/*",
    ],
  },
  // Configure a dedicated OAUTH_KV namespace before enabling MCP; see docs/mcp-configuration.md.
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "CanvasRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CanvasRoom"],
    },
    // Already applied in production. Retain the history and inactive class
    // exports so withdrawing Agent code does not recreate or delete namespaces.
    { "tag": "v2", "new_sqlite_classes": ["RunnerHub"] },
    { "tag": "v3", "new_sqlite_classes": ["AgentChatRouter"] },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qingdan-canvas",
      "database_id": "10b38932-94ba-4f29-8b50-9ba2313db9c2",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "qingdan-canvas-files",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "MCP_ENABLED": "false",
  },
  "observability": {
    "enabled": true,
  },
  "previews": {
    "vars": { "APP_ENV": "preview", "MCP_ENABLED": "false" },
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "CanvasRoom" }],
    },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "qingdan-canvas-preview",
        "database_id": "9cb763c2-d1dc-41a6-8899-d38cec0e0060",
        "migrations_dir": "migrations",
      },
    ],
    "r2_buckets": [
      { "binding": "FILES", "bucket_name": "qingdan-canvas-preview-files" },
    ],
  },
}
